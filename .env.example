# ============================================
# Infinity Legal ZA - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# --------------------------------------------
# Database (PostgreSQL via Neon / Vercel Postgres)
# --------------------------------------------
# Neon pooled connection (for application queries):
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# Same as DATABASE_URL (used as fallback when system overrides DATABASE_URL):
POSTGRES_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# Direct connection (for Prisma migrations):
DIRECT_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# --------------------------------------------
# Authentication
# --------------------------------------------
# JWT Secret: Generate with `openssl rand -hex 32`
# Used for signing JWT tokens (24h expiry)
JWT_SECRET=your-jwt-secret-here-min-32-chars

# Encryption Key: Generate with `openssl rand -hex 32`
# Used for AES-256-GCM encryption of sensitive data
ENCRYPTION_KEY=your-encryption-key-here-min-32-chars

# --------------------------------------------
# App Settings
# --------------------------------------------
# Public URL of the application (used for SEO, PayFast callbacks, CORS)
NEXT_PUBLIC_APP_URL=https://infinitylegal.org

# --------------------------------------------
# Node Environment
# --------------------------------------------
NODE_ENV=production

# --------------------------------------------
# PayFast Payment Integration
# --------------------------------------------
# Your PayFast merchant ID (from PayFast dashboard)
PAYFAST_MERCHANT_ID=your-merchant-id
# Your PayFast merchant key (from PayFast dashboard)
PAYFAST_MERCHANT_KEY=your-merchant-key
# PayFast passphrase (set in PayFast dashboard under Integration > Passphrase)
PAYFAST_PASSPHRASE=your-passphrase
# PayFast mode: "sandbox" for testing, "live" for production
PAYFAST_MODE=sandbox
