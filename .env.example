# ============================================
# Infinity Legal ZA - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# --------------------------------------------
# Database (PostgreSQL via Neon / Vercel Postgres)
# --------------------------------------------
# Neon pooled connection (for application queries):
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# Same as DATABASE_URL (used as fallback when system overrides DATABASE_URL):
POSTGRES_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# Direct connection (for Prisma migrations):
DIRECT_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# --------------------------------------------
# Authentication
# --------------------------------------------
# JWT Secret: Generate with `openssl rand -hex 32`
# Used for signing JWT tokens (24h expiry)
JWT_SECRET=your-jwt-secret-here-min-32-chars

# Encryption Key: Generate with `openssl rand -hex 32`
# Used for AES-256-GCM encryption of sensitive data
ENCRYPTION_KEY=your-encryption-key-here-min-32-chars

# --------------------------------------------
# App Settings
# --------------------------------------------
# Public URL of the application (used for SEO, PayFast callbacks, CORS)
NEXT_PUBLIC_APP_URL=https://infinitylegal.org

# --------------------------------------------
# Node Environment
# --------------------------------------------
NODE_ENV=production

# --------------------------------------------
# PayFast Payment Integration
# --------------------------------------------
# Your PayFast merchant ID (from PayFast dashboard)
PAYFAST_MERCHANT_ID=your-merchant-id
# Your PayFast merchant key (from PayFast dashboard)
PAYFAST_MERCHANT_KEY=your-merchant-key
# PayFast passphrase (set in PayFast dashboard under Integration > Passphrase)
PAYFAST_PASSPHRASE=your-passphrase
# PayFast mode: "sandbox" for testing, "live" for production
PAYFAST_MODE=sandbox

# --------------------------------------------
# Free LLM API Providers
# --------------------------------------------
# All providers listed below offer FREE tiers with no credit card required.
# See: https://github.com/cheahjs/free-llm-api-resources
# At minimum, configure Google AI Studio (primary) for AI features to work.
# The system falls back to z-ai-web-dev-sdk if no free provider is configured.

# Google AI Studio (Gemini) — PRIMARY provider
# Free: 250K tokens/min, 20 req/day for Flash models
# Best for: Complex legal analysis, document understanding
# Get key: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Groq — Ultra-fast inference (SECONDARY)
# Free: 14400 req/day for Llama 3.1 8B, 1000 req/day for 70B
# Best for: Real-time chat, quick responses
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# OpenRouter — Gateway to many models (TERTIARY/FALLBACK)
# Free: 20 req/min, 50 req/day
# Best for: Model diversity, DeepSeek V4 Flash
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Cohere — Legal text specialist (SUPPLEMENTARY)
# Free: 20 req/min, 1000 req/month
# Best for: Legal text generation, embeddings
# Get key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-api-key

# Cloudflare Workers AI — Edge inference (SUPPLEMENTARY)
# Free: 10,000 neurons/day
# Best for: Lightweight tasks, embeddings
# Get account ID from: https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
