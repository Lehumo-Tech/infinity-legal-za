# ============================================
# Infinity Legal ZA - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values.

# --------------------------------------------
# Supabase (Auth + Database)
# --------------------------------------------
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --------------------------------------------
# Authentication
# --------------------------------------------
# JWT_SECRET is no longer used (Supabase Auth handles tokens)
# Keep ENCRYPTION_KEY for AES-256-GCM encryption of sensitive data
ENCRYPTION_KEY=your-encryption-key-here-min-32-chars

# --------------------------------------------
# App Settings
# --------------------------------------------
NEXT_PUBLIC_APP_URL=https://infinitylegal.org
NODE_ENV=production

# --------------------------------------------
# PayFast Payment Integration
# --------------------------------------------
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_MODE=sandbox

# --------------------------------------------
# Stripe Payments (REPLACES PayFast when configured)
# --------------------------------------------
# 1. Create account at https://dashboard.stripe.com
# 2. Copy Secret + Publishable keys
# 3. Create recurring prices for each plan, copy price IDs
# 4. Add webhook at https://dashboard.stripe.com/webhooks →
#    URL: https://yourdomain.com/api/stripe/webhook
#    Events: checkout.session.completed, customer.subscription.updated,
#            customer.subscription.deleted, invoice.payment_succeeded
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_CIVIL=price_xxxxxxxxxxxxxxxxxx
STRIPE_PRICE_LABOUR=price_xxxxxxxxxxxxxxxxxx
STRIPE_PRICE_EXTENSIVE=price_xxxxxxxxxxxxxxxxxx

# --------------------------------------------
# Clerk Authentication (REPLACES local JWT when configured)
# --------------------------------------------
# 1. Create app at https://dashboard.clerk.com
# 2. Copy Publishable + Secret keys
# 3. Set sign-in/sign-up URLs below
# 4. Add webhook at https://dashboard.clerk.com → Webhooks →
#    URL: https://yourdomain.com/api/webhooks/clerk
#    Events: user.created, user.updated, user.deleted
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# --------------------------------------------
# Upstash Redis (Caching + Distributed Rate Limiting)
# --------------------------------------------
# 1. Create database at https://console.upstash.com
# 2. Copy REST URL + Token
# When absent, falls back to in-memory cache (no behavior change, just not distributed)
UPSTASH_REDIS_REST_URL=https://xxx-xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------
# Pinecone Vector Database (Legal document search + AI retrieval)
# --------------------------------------------
# 1. Create project at https://app.pinecone.io
# 2. Copy API key + create an index named "infinity-legal"
PINECONE_API_KEY=pcxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PINECONE_INDEX_NAME=infinity-legal

# --------------------------------------------
# PostHog Analytics (Product analytics + session replay)
# --------------------------------------------
# 1. Create project at https://app.posthog.com
# 2. Copy "Project API Key" (phc_...)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --------------------------------------------
# Sentry Error Tracking (Auto-activates with DSN)
# --------------------------------------------
# 1. Create project at https://sentry.io → Next.js
# 2. Copy the DSN
# 3. (Optional) For source maps: add SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxx
SENTRY_RELEASE=optional-release-tag

# --------------------------------------------
# Free LLM API Providers
# --------------------------------------------
# All providers offer FREE tiers. The system falls back to z-ai-web-dev-sdk if none configured.

# Google AI Studio (Gemini) — PRIMARY
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Groq — Ultra-fast inference (SECONDARY)
GROQ_API_KEY=your-groq-api-key

# OpenRouter — Gateway to many models (TERTIARY)
OPENROUTER_API_KEY=your-openrouter-api-key

# Cohere — Legal text specialist (SUPPLEMENTARY)
COHERE_API_KEY=your-cohere-api-key

# Cloudflare Workers AI — Edge inference (SUPPLEMENTARY)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# --------------------------------------------
# Email Service (SMTP or Resend)
# --------------------------------------------
# The system supports two email providers. SMTP is checked first, then Resend.
# If neither is configured, emails are logged (simulation mode) — great for testing.

# Option 1: SMTP (Recommended — works with Gmail, Outlook, AWS SES, etc.)
# Gmail: smtp.gmail.com, port 587, enable 2FA + App Password
# Outlook: smtp.office365.com, port 587
# AWS SES: email-smtp.af-south-1.amazonaws.com, port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false

# Option 2: Resend API (Modern email API — free 100 emails/day)
# Get a key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# Sender address (used by both SMTP and Resend)
EMAIL_FROM="Infinity Legal SA <info@infinitylegal.org>"

# --------------------------------------------
# SMS Service (Twilio)
# --------------------------------------------
# Supports South African numbers (+27 format)
# Get credentials at https://www.twilio.com
# Free trial includes test SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
