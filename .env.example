# ============================================
# Infinity Legal ZA - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# --------------------------------------------
# Database (PostgreSQL via Prisma)
# --------------------------------------------
# Local development:
DATABASE_URL=postgresql://user:password@localhost:5432/infinitylegal
# Vercel Postgres (auto-configured when you add Vercel Postgres storage):
# DATABASE_URL=postgresql://default:xxxxx@ep-xxxxx.us-east-2.aws.neon.tech/verceldb?sslmode=require

# --------------------------------------------
# Authentication
# --------------------------------------------
# JWT Secret: Generate with `openssl rand -hex 32`
JWT_SECRET=your-jwt-secret-here-min-32-chars

# Encryption Key: Generate with `openssl rand -hex 32`
ENCRYPTION_KEY=your-encryption-key-here-min-32-chars

# --------------------------------------------
# App Settings
# --------------------------------------------
NEXT_PUBLIC_APP_URL=https://infinitylegal.org

# --------------------------------------------
# Node Environment
# --------------------------------------------
NODE_ENV=production
