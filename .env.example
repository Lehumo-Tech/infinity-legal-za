# ============================================
# Infinity Legal SA — Environment Variables
# ============================================
# Copy to .env and fill in. Services with no key stay gracefully disabled
# (the app runs in a reduced "not configured" mode for that integration).

# --------------------------------------------
# 0. Core App
# --------------------------------------------
DATABASE_URL=file:/home/z/my-project/db/custom.db
NEXT_PUBLIC_APP_URL=https://infinitylegal.org
ENCRYPTION_KEY=<32+ char random string for AES-256-GCM>
NODE_ENV=development

# --------------------------------------------
# 1. Sentry — Error Tracking
# --------------------------------------------
# Get DSN: https://sentry.io → create project (Next.js) → copy DSN
# Optional: SENTRY_AUTH_TOKEN + SENTRY_ORG + SENTRY_PROJECT for source maps
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=

# --------------------------------------------
# 2. Resend — Transactional Email
# --------------------------------------------
# Get key: https://resend.com → API Keys
# Verify your sending domain first. EMAIL_FROM must use a verified domain.
RESEND_API_KEY=
EMAIL_FROM=Infinity Legal SA <noreply@infinitylegal.org>
# (SMTP alternative — leave RESEND_API_KEY blank to use SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --------------------------------------------
# 3. Stripe — Payments & Subscriptions
# --------------------------------------------
# Get keys: https://dashboard.stripe.com → Developers → API keys
# Create 3 recurring prices (monthly, ZAR) and copy price IDs
# Webhook: dashboard.stripe.com/webhooks → add endpoint for /api/stripe/webhook
#   events: checkout.session.completed, customer.subscription.updated,
#           customer.subscription.deleted, invoice.payment_succeeded
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CIVIL=
STRIPE_PRICE_LABOUR=
STRIPE_PRICE_EXTENSIVE=

# --------------------------------------------
# 4. Clerk — Authentication
# --------------------------------------------
# Get keys: https://dashboard.clerk.com → create app → API Keys
# Webhook: dashboard.clerk.com → Webhooks → endpoint /api/webhooks/clerk
#   events: user.created, user.updated, user.deleted
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# --------------------------------------------
# 5. Upstash — Redis (caching + rate limiting)
# --------------------------------------------
# Get keys: https://console.upstash.com → create database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --------------------------------------------
# 6. Pinecone — Vector Database (AI legal search)
# --------------------------------------------
# Get key: https://app.pinecone.io → create index (1536 dims recommended)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=infinity-legal

# --------------------------------------------
# 7. PostHog — Product Analytics
# --------------------------------------------
# Get key: https://app.posthog.com → project settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --------------------------------------------
# 8. PayFast — Payments (legacy — Stripe replaces this when STRIPE_SECRET_KEY is set)
# --------------------------------------------
# Local South African payment gateway. Used by /api/payfast/* and PaymentWall
# when Stripe is not configured. Leave blank to disable.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox

# --------------------------------------------
# 9. Twilio — SMS (legacy, optional)
# --------------------------------------------
# South African SMS support. Leave blank to run in SMS simulation mode
# (messages logged but not actually sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
