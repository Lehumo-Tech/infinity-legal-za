// ============================================================================
// Infinity Legal SA — Comprehensive Prisma Schema
// ----------------------------------------------------------------------------
// Covers ALL application functionality:
//   Auth & Users, Organization (Departments), Clients, Pricing & Billing
//   (Stripe + PayFast + Invoices + Refunds), Cases & Legal Work (parties,
//   consultations, tasks, time entries, documents + sharing), Leads & Intake
//   (AI intake + contact messages), Messaging & Notifications, AI Features
//   (intake sessions, analyses, chat, legal memos), Communications (email/SMS
//   + templates), Audit & Operations (webhook events, backups, settings),
//   Knowledge Base (legal articles).
//
// Provider notes:
//   - Database: SQLite (no native arrays → use Json; no enforced CHECK →
//     enums are documented as comments and validated in the API layer).
//   - Payment providers: Stripe AND PayFast coexist (selectable per
//     deployment). Both `stripe_*` and `payfast_*` fields are kept.
//   - Auth: Local JWT (primary) + Clerk (conditional, env-driven).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// SECTION 1 — AUTH, USERS & STAFF
// ============================================================================

// ------------------------------------
// USER (Auth + Staff + Client accounts)
// ------------------------------------
model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  password                 String // hashed password (salt:hash format)
  full_name                String
  phone                    String?
  avatar_url               String?
  /// CHECK: client | attorney | paralegal | admin | managing_director |
  ///        systems_admin | senior_partner | supervising_officer | legal_officer |
  ///        associate | senior_consultant | hr_manager | finance_manager |
  ///        consultant | candidate_attorney | office_administrator | receptionist | guest
  /// NOTE: "attorney" is the internal enum value (matches SA Legal Practice
  ///       Council registration). In all user-facing UI it is displayed as
  ///       "Legal Advisor". See src/lib/auth.ts for the canonical role list.
  role                     String    @default("client")
  department               String? // legacy free-text department (kept for back-compat)
  department_id            String? // FK → Department (org chart / hierarchy)
  manager_id               String? // FK → User (self-ref, reporting line for org chart)
  id_number                String?
  company                  String?
  address                  Json?
  practice_number          String? // For legal advisors (LPC registration)
  bar_admission_date       DateTime? // For legal advisors
  specialization           Json? // For legal advisors (was String[] in PG)
  hourly_rate              Float? // For legal advisors
  bio                      String? // For legal advisors
  is_active                Boolean   @default(true)
  email_verified           Boolean   @default(false)
  popi_consent             Boolean   @default(false)
  password_expires_at      DateTime?
  last_password_change     DateTime?
  last_login_at            DateTime?
  last_active_at           DateTime? // Last known activity timestamp (engagement tracking)
  clerk_id                 String?   @unique // Clerk user ID (when Clerk auth is enabled)
  // --- HR fields ---
  employment_start_date    DateTime? // Tenure tracking (/api/hr)
  employment_end_date      DateTime? // When staff left (separate from is_active soft-delete)
  employment_type          String? // permanent | contract | intern | consultant
  emergency_contact        Json? // { name, phone, relationship }
  next_of_kin              Json? // { name, phone, relationship }
  notification_preferences Json? // { email, sms, push, categories: {...}, quiet_hours }
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  // Reverse relations
  client_profile            Client?
  departmentOrg             Department?        @relation("DepartmentMembers", fields: [departmentId], references: [id])
  department_head           Department[]       @relation("DepartmentHead")
  manager                   User?              @relation("UserManager", fields: [manager_id], references: [id])
  direct_reports            User[]             @relation("UserManager")
  cases_as_attorney         Case[]
  cases_as_paralegal        Case[]             @relation("CaseParalegal")
  documents_uploaded        Document[]
  document_shares_granted   DocumentShare[]    @relation("DocumentShareGrantor")
  document_shares_received  DocumentShare[]    @relation("DocumentShareGrantee")
  messages_sent             Message[]          @relation("MessageSender")
  messages_received         Message[]          @relation("MessageRecipient")
  tasks_assigned            Task[]             @relation("TaskAssignedTo")
  tasks_created             Task[]             @relation("TaskCreatedBy")
  timeline_events           CaseTimeline[]
  case_parties              CaseParty[]        @relation("CasePartyAddedBy")
  consultations_as_client   Consultation[]     @relation("ConsultationClient")
  consultations_as_attorney Consultation[]     @relation("ConsultationAttorney")
  privileged_notes          PrivilegedNote[]
  consent_logs              ConsentLog[]
  notifications             Notification[]
  audit_logs                AuditLog[]
  intake_submissions        IntakeSubmission[] @relation("IntakeReviewer")
  leads_assigned            IntakeSubmission[] @relation("LeadAssignee")
  ai_analyses_requested     AiAnalysis[]
  ai_chat_sessions          AiChatSession[]
  ai_memos                  LegalMemo[]        @relation("LegalMemoAuthor")
  communication_logs        CommunicationLog[]
  contact_messages_assigned ContactMessage[]   @relation("ContactMessageAssignee")
  contact_messages_resolved ContactMessage[]   @relation("ContactMessageResolver")
  time_entries              TimeEntry[]
  backups_initiated         BackupRecord[]
  refunds_processed         Refund[]           @relation("RefundProcessor")
  webhook_events            WebhookEvent[]
  articles_authored         LegalArticle[]     @relation("ArticleAuthor")
  departmentId              String?

  @@index([role])
  @@index([email])
  @@index([is_active])
  @@index([department_id])
  @@index([manager_id])
}

// ------------------------------------
// DEPARTMENT (Org chart / staff hierarchy)
// ------------------------------------
model Department {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  head_id     String? // FK → User (department head)
  parent_id   String? // self-ref for nested departments
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  head     User?        @relation("DepartmentHead", fields: [head_id], references: [id])
  parent   Department?  @relation("DepartmentHierarchy", fields: [parent_id], references: [id])
  children Department[] @relation("DepartmentHierarchy")
  members  User[]       @relation("DepartmentMembers")

  @@index([slug])
  @@index([parent_id])
  @@index([is_active])
}

// ------------------------------------
// ADMIN SESSIONS (Reserved — JWT is primary; model kept for future token store)
// ------------------------------------
model AdminSession {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  ip_address String?
  user_agent String?
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([token])
  @@index([user_id])
  @@index([expires_at])
}

// ------------------------------------
// OTP VERIFICATION (signup OTP, password reset, email/phone verification)
// ------------------------------------
model OtpVerification {
  id           String    @id @default(uuid())
  email        String
  otp_code     String
  /// CHECK: pending | verified | expired | failed
  status       String    @default("pending")
  /// CHECK: signup_otp | password_reset | email_verification | phone_verification
  /// Disambiguates the OTP purpose (previously overloaded — reset tokens were
  /// stored in otp_code with no purpose marker).
  purpose      String    @default("signup_otp")
  attempts     Int       @default(0)
  max_attempts Int       @default(3)
  ip_address   String?
  user_agent   String?
  verified_at  DateTime?
  expires_at   DateTime
  created_at   DateTime  @default(now())

  @@index([email, status, expires_at])
  @@index([otp_code, status, expires_at])
  @@index([purpose])
  @@index([expires_at])
}

// ============================================================================
// SECTION 2 — CLIENTS
// ============================================================================

// ------------------------------------
// CLIENT (Extended profile for legal clients)
// ------------------------------------
model Client {
  id                     String    @id @default(uuid())
  user_id                String    @unique
  contract_number        String?   @unique
  id_number              String?
  plan_id                String?
  /// CHECK: none | active | past_due | cancelled | expired | trial
  subscription_status    String    @default("none")
  membership_number      String?   @unique
  membership_card_issued Boolean   @default(false)
  address                Json?
  employer               String?
  occupation             String?
  annual_income          Float?
  date_of_birth          DateTime? // Estate planning, family law, immigration
  referred_by            String? // Free-text referrer (person/source)
  referrer_user_id       String? // FK → User (if referred by an existing user/staff)
  notes                  String?
  tags                   Json? // was String[] in PG
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  user               User               @relation(fields: [user_id], references: [id])
  plan               PricingPlan?       @relation(fields: [plan_id], references: [id])
  cases              Case[]
  intake_submissions IntakeSubmission[] @relation("IntakeClient")
  subscriptions      UserSubscription[]
  payment_records    PaymentRecord[]
  invoices           Invoice[]
  contact_messages   ContactMessage[]

  @@index([user_id])
  @@index([contract_number])
  @@index([membership_number])
  @@index([subscription_status])
  @@index([referrer_user_id])
}

// ------------------------------------
// CONSENT LOGS (POPIA compliance)
// ------------------------------------
model ConsentLog {
  id           String   @id @default(uuid())
  user_id      String?
  /// CHECK: terms_of_service | privacy_policy | popi_act | marketing | data_processing
  consent_type String
  granted      Boolean
  ip_address   String?
  user_agent   String?
  version      String?
  created_at   DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([consent_type])
  @@index([created_at])
}

// ============================================================================
// SECTION 3 — PRICING & BILLING (Stripe + PayFast + Invoices + Refunds)
// ============================================================================

// ------------------------------------
// PRICING PLANS
// ------------------------------------
model PricingPlan {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  price_monthly Float
  price_annual  Float?
  currency      String   @default("ZAR")
  features      Json?
  max_cases     Int      @default(10)
  max_documents Int      @default(50)
  is_popular    Boolean  @default(false)
  is_active     Boolean  @default(true)
  sort_order    Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  clients       Client[]
  subscriptions UserSubscription[]

  @@index([slug])
  @@index([is_active])
}

// ------------------------------------
// USER SUBSCRIPTIONS (Stripe + PayFast)
// ------------------------------------
model UserSubscription {
  id                     String    @id @default(uuid())
  client_id              String    @unique
  plan_id                String
  /// CHECK: active | past_due | cancelled | expired | trial
  status                 String    @default("active")
  billing_cycle          String?   @default("monthly") // monthly | annual
  current_period_start   DateTime?
  current_period_end     DateTime?
  cancel_at_period_end   Boolean   @default(false)
  auto_renew             Boolean   @default(true)
  trial_ends_at          DateTime?
  cancelled_at           DateTime? // Actual cancellation timestamp
  cancellation_reason    String? // Why the subscription was cancelled
  // PayFast integration
  payfast_token          String?
  // Stripe integration (populated when Stripe is the active provider)
  stripe_customer_id     String?
  stripe_subscription_id String?
  stripe_price_id        String?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  client          Client          @relation(fields: [client_id], references: [id])
  plan            PricingPlan     @relation(fields: [plan_id], references: [id])
  payment_records PaymentRecord[]
  invoices        Invoice[]

  @@index([plan_id])
  @@index([status])
  @@index([stripe_subscription_id])
  @@index([stripe_customer_id])
  @@index([payfast_token])
}

// ------------------------------------
// PAYMENT RECORDS (PayFast + Stripe integration)
// ------------------------------------
model PaymentRecord {
  id                  String    @id @default(uuid())
  subscription_id     String?
  case_id             String?
  client_id           String
  amount              Float
  currency            String?   @default("ZAR")
  /// CHECK: pending | completed | failed | refunded | partially_refunded
  status              String    @default("pending")
  payfast_payment_id  String?
  payfast_token       String?
  payfast_merchant_id String?
  payfast_signature   String?
  payment_method      String?
  description         String?
  metadata            Json?
  // Unified provider fields
  provider            String?   @default("payfast") // payfast | stripe
  provider_payment_id String? // Stripe session/charge ID or PayFast mPaymentId
  // Stripe-specific
  stripe_event_id     String? // For webhook idempotency
  stripe_invoice_id   String? // Stripe invoice ID string (for lookup; relation via invoice_id)
  // Accounting breakdown
  tax_amount          Float?
  fee_amount          Float?
  discount_amount     Float?
  // Refund tracking (denormalized for quick status; full refund history in Refund)
  refund_amount       Float?    @default(0)
  refund_reason       String?
  refunded_at         DateTime?
  invoice_id          String? // FK → Invoice (proper relation)
  paid_at             DateTime?
  created_at          DateTime  @default(now())

  subscription UserSubscription? @relation(fields: [subscription_id], references: [id])
  case         Case?             @relation(fields: [case_id], references: [id])
  client       Client            @relation(fields: [client_id], references: [id])
  invoice      Invoice?          @relation(fields: [invoice_id], references: [id])
  refunds      Refund[]

  @@index([subscription_id])
  @@index([case_id])
  @@index([client_id])
  @@index([status])
  @@index([provider, provider_payment_id])
  @@index([payfast_payment_id])
  @@index([stripe_event_id])
  @@index([stripe_invoice_id])
  @@index([invoice_id])
  @@index([created_at])
}

// ------------------------------------
// INVOICE (Stripe invoicing / billing)
// ------------------------------------
model Invoice {
  id                     String    @id @default(uuid())
  subscription_id        String?
  client_id              String
  stripe_invoice_id      String?   @unique
  stripe_invoice_url     String?
  stripe_invoice_pdf_url String?
  number                 String? // Human-readable invoice number (INV-2026-001)
  amount                 Float
  currency               String?   @default("ZAR")
  tax_amount             Float?    @default(0)
  discount_amount        Float?    @default(0)
  /// CHECK: draft | open | paid | void | uncollectible
  status                 String    @default("draft")
  issued_at              DateTime?
  due_at                 DateTime?
  paid_at                DateTime?
  metadata               Json?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  subscription    UserSubscription? @relation(fields: [subscription_id], references: [id])
  client          Client            @relation(fields: [client_id], references: [id])
  payment_records PaymentRecord[]

  @@index([client_id, status, issued_at])
  @@index([subscription_id])
  @@index([status])
  @@index([issued_at])
}

// ------------------------------------
// REFUND (Full refund history per payment)
// ------------------------------------
model Refund {
  id                String    @id @default(uuid())
  payment_id        String
  amount            Float
  reason            String?
  stripe_refund_id  String?   @unique
  payfast_refund_id String?
  /// CHECK: pending | completed | failed | cancelled
  status            String    @default("pending")
  processed_by      String // FK → User
  processed_at      DateTime?
  metadata          Json?
  created_at        DateTime  @default(now())

  payment   PaymentRecord @relation(fields: [payment_id], references: [id])
  processor User          @relation("RefundProcessor", fields: [processed_by], references: [id])

  @@index([payment_id])
  @@index([status])
  @@index([stripe_refund_id])
  @@index([created_at])
}

// ============================================================================
// SECTION 4 — CASES & LEGAL WORK
// ============================================================================

// ------------------------------------
// CASES
// ------------------------------------
model Case {
  id              String    @id @default(uuid())
  case_ref        String    @unique
  case_number     String? // Court-assigned number
  title           String
  description     String?
  /// CHECK: civil | criminal | family | corporate | property | labour | immigration | tax | personal_injury | debt_recovery | other
  case_type       String
  /// CHECK: low | medium | high | critical
  urgency         String    @default("medium")
  /// CHECK: intake | review | active | on_hold | closed | archived
  status          String    @default("intake")
  client_id       String
  attorney_id     String?
  paralegal_id    String? // Assigned paralegal (separate from lead attorney)
  opposing_party  String? // Legacy free-text (CaseParty model supports multiple)
  court_name      String?
  jurisdiction    String?
  estimated_value Float?
  retainer_amount Float?
  contingency_fee Float? // Contingency fee percentage (accepted by /api/cases/[id] PUT)
  next_deadline   DateTime?
  notes           String?
  is_high_risk    Boolean   @default(false)
  closed_at       DateTime?
  /// CHECK: won | lost | settled | withdrawn | abandoned | other
  closed_reason   String? // Outcome tracking (case_win_rate analytics)
  tags            Json? // was String[] in PG
  metadata        Json?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  client             Client             @relation(fields: [client_id], references: [id])
  attorney           User?              @relation(fields: [attorney_id], references: [id])
  paralegal          User?              @relation("CaseParalegal", fields: [paralegal_id], references: [id])
  intake_submissions IntakeSubmission[]
  documents          Document[]
  tasks              Task[]
  messages           Message[]
  timeline_events    CaseTimeline[]
  privileged_notes   PrivilegedNote[]
  consultations      Consultation[]
  payment_records    PaymentRecord[]
  ai_analyses        AiAnalysis[]
  case_parties       CaseParty[]
  time_entries       TimeEntry[]
  legal_memos        LegalMemo[]

  @@index([status])
  @@index([case_type])
  @@index([urgency])
  @@index([client_id, status])
  @@index([attorney_id, status])
  @@index([paralegal_id])
  @@index([closed_at])
  @@index([created_at])
}

// ------------------------------------
// CASE PARTIES (Opposing parties, counsel, witnesses, experts)
// ------------------------------------
model CaseParty {
  id                   String   @id @default(uuid())
  case_id              String
  name                 String
  /// CHECK: opposing_party | opposing_counsel | co_defendant | witness | expert | plaintiff | respondent | other
  role                 String   @default("opposing_party")
  contact_info         Json? // { email, phone, address }
  legal_representative String? // Counsel name if represented
  notes                String?
  added_by             String? // FK → User
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  case    Case  @relation(fields: [case_id], references: [id])
  addedBy User? @relation("CasePartyAddedBy", fields: [added_by], references: [id])

  @@index([case_id])
  @@index([role])
  @@index([added_by])
}

// ------------------------------------
// CASE TIMELINE (Status timeline)
// ------------------------------------
model CaseTimeline {
  id                String   @id @default(uuid())
  case_id           String
  event_type        String
  event_description String
  performed_by      String?
  metadata          Json?
  is_system_event   Boolean  @default(false)
  created_at        DateTime @default(now())

  case      Case  @relation(fields: [case_id], references: [id])
  performer User? @relation(fields: [performed_by], references: [id])

  @@index([case_id])
  @@index([event_type])
  @@index([created_at])
}

// ------------------------------------
// PRIVILEGED NOTES
// ------------------------------------
model PrivilegedNote {
  id            String   @id @default(uuid())
  case_id       String
  author_id     String
  content       String
  is_privileged Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  case   Case @relation(fields: [case_id], references: [id])
  author User @relation(fields: [author_id], references: [id])

  @@index([case_id])
  @@index([author_id])
}

// ------------------------------------
// CONSULTATIONS
// NOTE: client_id references User.id (the client's auth account), NOT
// Client.id. This matches the existing /api/consultations implementation.
// ------------------------------------
model Consultation {
  id                  String    @id @default(uuid())
  case_id             String?
  client_id           String // FK → User (the client's auth account)
  attorney_id         String?
  /// CHECK: scheduled | confirmed | in_progress | completed | cancelled | no_show
  status              String    @default("scheduled")
  scheduled_at        DateTime
  duration_minutes    Int       @default(60)
  meeting_type        String?
  meeting_link        String?
  location            String?
  notes               String?
  follow_up_required  Boolean   @default(false)
  fee                 Float?
  cancellation_reason String?
  reminder_sent_at    DateTime? // Tracking for consultation_reminder template
  fee_paid            Boolean   @default(false)
  payment_id          String? // FK → PaymentRecord (link consultation fee to payment)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  case     Case? @relation(fields: [case_id], references: [id])
  client   User  @relation("ConsultationClient", fields: [client_id], references: [id])
  attorney User? @relation("ConsultationAttorney", fields: [attorney_id], references: [id])

  @@index([case_id])
  @@index([client_id, scheduled_at, status])
  @@index([attorney_id, scheduled_at, status])
  @@index([scheduled_at])
  @@index([status])
}

// ------------------------------------
// TASKS
// ------------------------------------
model Task {
  id                String    @id @default(uuid())
  case_id           String?
  assigned_to       String
  created_by        String
  title             String
  description       String?
  /// CHECK: pending | in_progress | completed | cancelled
  status            String    @default("pending")
  /// CHECK: low | medium | high | urgent
  priority          String    @default("medium")
  due_date          DateTime?
  completed_at      DateTime?
  estimated_minutes Int? // Time tracking
  actual_minutes    Int? // Time tracking
  parent_task_id    String? // Self-FK for subtasks
  tags              Json? // was absent; now supports tagging
  metadata          Json?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  case         Case?       @relation(fields: [case_id], references: [id])
  assignee     User        @relation("TaskAssignedTo", fields: [assigned_to], references: [id])
  creator      User        @relation("TaskCreatedBy", fields: [created_by], references: [id])
  parent       Task?       @relation("TaskHierarchy", fields: [parent_task_id], references: [id])
  subtasks     Task[]      @relation("TaskHierarchy")
  time_entries TimeEntry[]

  @@index([assigned_to, status, due_date])
  @@index([case_id])
  @@index([due_date])
  @@index([priority])
  @@index([parent_task_id])
}

// ------------------------------------
// TIME ENTRIES (Billable hours / staff utilization)
// ------------------------------------
model TimeEntry {
  id          String    @id @default(uuid())
  case_id     String?
  task_id     String?
  user_id     String
  description String
  minutes     Int
  billable    Boolean   @default(true)
  hourly_rate Float?
  billed      Boolean   @default(false)
  invoice_id  String?
  started_at  DateTime?
  ended_at    DateTime?
  metadata    Json?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  case Case? @relation(fields: [case_id], references: [id])
  task Task? @relation(fields: [task_id], references: [id])
  user User  @relation(fields: [user_id], references: [id])

  @@index([user_id, case_id, started_at])
  @@index([case_id])
  @@index([task_id])
  @@index([billable, billed])
  @@index([started_at])
}

// ------------------------------------
// DOCUMENTS
// ------------------------------------
model Document {
  id                 String    @id @default(uuid())
  case_id            String?
  uploaded_by        String?
  title              String?
  /// CHECK: id_document | contract | court_filing | correspondence | evidence | financial | medical | police_report | affidavit | other
  document_type      String
  /// CHECK: uploading | uploaded | reviewing | approved | rejected | archived
  status             String    @default("uploading")
  file_name          String
  file_path          String
  file_size          Int?
  mime_type          String?
  file_hash          String? // SHA-256 for integrity / duplicate detection
  description        String?
  tags               Json? // was String[] in PG
  version            Int       @default(1)
  parent_document_id String?
  ai_extracted_text  String?
  ai_summary         String?
  ai_categories      Json? // AI-generated categories
  is_confidential    Boolean   @default(false)
  download_count     Int       @default(0) // Audit trail for confidential docs
  expires_at         DateTime? // Time-limited access (e.g., settlement offers)
  metadata           Json?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  case            Case?           @relation(fields: [case_id], references: [id])
  uploader        User?           @relation(fields: [uploaded_by], references: [id])
  parent_document Document?       @relation("DocumentHierarchy", fields: [parent_document_id], references: [id])
  child_documents Document[]      @relation("DocumentHierarchy")
  shares          DocumentShare[]

  @@index([case_id, status])
  @@index([document_type])
  @@index([status])
  @@index([uploaded_by])
  @@index([file_hash])
  @@index([created_at])
}

// ------------------------------------
// DOCUMENT SHARE (Time-limited access grants)
// ------------------------------------
model DocumentShare {
  id                 String    @id @default(uuid())
  document_id        String
  granted_by         String // FK → User
  granted_to_email   String
  granted_to_user_id String? // FK → User (if internal)
  token              String    @unique // URL token for external access
  expires_at         DateTime?
  view_count         Int       @default(0)
  max_views          Int?
  revoked_at         DateTime?
  metadata           Json?
  created_at         DateTime  @default(now())

  document Document @relation(fields: [document_id], references: [id])
  grantor  User     @relation("DocumentShareGrantor", fields: [granted_by], references: [id])
  grantee  User?    @relation("DocumentShareGrantee", fields: [granted_to_user_id], references: [id])

  @@index([document_id, expires_at])
  @@index([granted_by])
  @@index([granted_to_user_id])
  @@index([token])
  @@index([expires_at])
}

// ============================================================================
// SECTION 5 — LEADS & INTAKE
// ============================================================================

// ------------------------------------
// INTAKE SUBMISSIONS (AI-powered intake / Leads)
// NOTE: "Leads" are IntakeSubmission rows with status != 'draft'.
// ------------------------------------
model IntakeSubmission {
  id                  String    @id @default(uuid())
  client_id           String?
  case_id             String?
  /// CHECK: draft | submitted | under_review | approved | rejected | additional_info_needed |
  ///        new | contacted | qualified | consultation_scheduled | retained | lost | nurturing
  status              String    @default("draft")
  case_type           String?
  case_description    String?
  opposing_party      String?
  estimated_value     Float?
  /// CHECK: low | medium | high | critical
  urgency             String?
  timeline            String?
  desired_outcome     String?
  previous_legal_help String?
  documents_ready     Boolean?
  // --- Lead management (top-level columns for queryability) ---
  first_name          String? // Extracted from personal_info.full_name
  last_name           String? // Extracted from personal_info.full_name
  source              String? // web | referral | social | walk_in | partner | other
  lead_score          Int? // 0-100 score for prioritization
  assigned_to         String? // FK → User (lead owner)
  next_follow_up      DateTime? // Scheduled follow-up
  notes               String? // Staff notes (was buried in personal_info JSON)
  converted_at        DateTime? // When lead was converted to client+case
  // --- JSON blobs ---
  personal_info       Json?
  case_details        Json?
  financial_info      Json?
  ai_extracted_data   Json?
  ai_confidence       Float?
  ai_summary          String?
  ai_recommendations  Json?
  review_notes        String?
  reviewed_by         String?
  reviewed_at         DateTime?
  submitted_at        DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  client      Client?           @relation("IntakeClient", fields: [client_id], references: [id])
  case        Case?             @relation(fields: [case_id], references: [id])
  reviewer    User?             @relation("IntakeReviewer", fields: [reviewed_by], references: [id])
  assignee    User?             @relation("LeadAssignee", fields: [assigned_to], references: [id])
  ai_sessions AiIntakeSession[]
  ai_analyses AiAnalysis[]

  @@index([status, created_at])
  @@index([client_id])
  @@index([case_id])
  @@index([assigned_to, status])
  @@index([source, status])
  @@index([lead_score])
  @@index([next_follow_up])
  @@index([created_at])
}

// ------------------------------------
// CONTACT MESSAGE (Public contact form submissions)
// ------------------------------------
model ContactMessage {
  id               String    @id @default(uuid())
  name             String
  email            String
  phone            String?
  subject          String
  message          String
  /// CHECK: new | in_progress | resolved | spam
  status           String    @default("new")
  popia_consent    Boolean   @default(false)
  ip_address       String?
  user_agent       String?
  client_id        String? // FK → Client (if resolved to an existing client)
  assigned_to      String? // FK → User (staff owner)
  resolved_at      DateTime?
  resolved_by      String? // FK → User
  resolution_notes String?
  metadata         Json?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  client   Client? @relation(fields: [client_id], references: [id])
  assignee User?   @relation("ContactMessageAssignee", fields: [assigned_to], references: [id])
  resolver User?   @relation("ContactMessageResolver", fields: [resolved_by], references: [id])

  @@index([status, created_at])
  @@index([email])
  @@index([assigned_to])
  @@index([client_id])
  @@index([created_at])
}

// ============================================================================
// SECTION 6 — MESSAGING & NOTIFICATIONS
// ============================================================================

// ------------------------------------
// MESSAGES (Secure client-attorney chat)
// ------------------------------------
model Message {
  id                String    @id @default(uuid())
  case_id           String?
  sender_id         String
  recipient_id      String?
  /// CHECK: system | direct | group | notification
  message_type      String    @default("direct")
  subject           String?
  content           String
  is_read           Boolean   @default(false)
  is_encrypted      Boolean   @default(false)
  edited_at         DateTime?
  deleted_at        DateTime? // Soft delete
  attachments       Json? // [{ file_name, file_path, file_size, mime_type }]
  parent_message_id String?
  metadata          Json?
  created_at        DateTime  @default(now())

  case           Case?     @relation(fields: [case_id], references: [id])
  sender         User      @relation("MessageSender", fields: [sender_id], references: [id])
  recipient      User?     @relation("MessageRecipient", fields: [recipient_id], references: [id])
  parent_message Message?  @relation("MessageThread", fields: [parent_message_id], references: [id])
  replies        Message[] @relation("MessageThread")

  @@index([case_id])
  @@index([sender_id])
  @@index([recipient_id, is_read, created_at])
  @@index([parent_message_id])
  @@index([created_at])
}

// ------------------------------------
// NOTIFICATIONS
// ------------------------------------
model Notification {
  id         String    @id @default(uuid())
  user_id    String
  title      String
  message    String
  /// CHECK: info | warning | success | error
  type       String    @default("info")
  /// CHECK: case_update | task_assigned | task_status_update | new_message | payment | consultation | system | billing | other
  category   String    @default("other")
  priority   String    @default("normal") // low | normal | high | urgent
  link       String?
  is_read    Boolean   @default(false)
  expires_at DateTime? // Auto-expire stale notifications
  metadata   Json?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, is_read, created_at])
  @@index([type])
  @@index([category])
  @@index([priority])
  @@index([expires_at])
  @@index([created_at])
}

// ============================================================================
// SECTION 7 — AI FEATURES
// ============================================================================

// ------------------------------------
// AI INTAKE SESSIONS (Single-use AI intake flows)
// ------------------------------------
model AiIntakeSession {
  id                   String    @id @default(uuid())
  client_id            String?
  intake_submission_id String?
  session_token        String?   @unique
  /// CHECK: draft | submitted | under_review | completed | abandoned
  status               String    @default("draft")
  conversation_history Json?
  extracted_entities   Json?
  current_step         String?
  steps_completed      Json? // was String[] in PG
  steps_remaining      Json? // was String[] in PG
  ai_model_used        String?
  total_tokens         Int?
  completed_at         DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  intake_submission IntakeSubmission? @relation(fields: [intake_submission_id], references: [id])

  @@index([session_token])
  @@index([status])
}

// ------------------------------------
// AI ANALYSES (Merit assessment, risk analysis, etc.)
// ------------------------------------
model AiAnalysis {
  id                 String    @id @default(uuid())
  case_id            String?
  intake_id          String?
  /// CHECK: merit_assessment | risk_analysis | cost_estimate | timeline_prediction | document_review | legal_research | strategy_recommendation
  analysis_type      String
  /// CHECK: pending | processing | completed | failed
  status             String    @default("pending")
  input_data         Json?
  result             Json?
  summary            String?
  recommendations    Json?
  risk_flags         Json?
  confidence_score   Float?
  ai_model_used      String?
  tokens_used        Int?
  processing_time_ms Int?
  error_message      String?
  requested_by       String?
  completed_at       DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  case      Case?             @relation(fields: [case_id], references: [id])
  intake    IntakeSubmission? @relation(fields: [intake_id], references: [id])
  requester User?             @relation(fields: [requested_by], references: [id])

  @@index([case_id])
  @@index([analysis_type])
  @@index([status])
  @@index([created_at])
}

// ------------------------------------
// AI CHAT SESSION (Multi-turn legal chat — persistent conversation history)
// ------------------------------------
model AiChatSession {
  id              String    @id @default(uuid())
  user_id         String? // FK → User (null for anonymous)
  session_token   String    @unique
  /// CHECK: active | cleared | archived
  status          String    @default("active")
  title           String? // Optional conversation title
  provider        String? // openai | anthropic | glm | etc.
  model           String?
  total_tokens    Int       @default(0)
  message_count   Int       @default(0)
  started_at      DateTime  @default(now())
  last_message_at DateTime?
  metadata        Json?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user     User?           @relation(fields: [user_id], references: [id])
  messages AiChatMessage[]

  @@index([user_id, last_message_at])
  @@index([session_token])
  @@index([status])
  @@index([last_message_at])
}

// ------------------------------------
// AI CHAT MESSAGE (Individual messages in an AI chat session)
// ------------------------------------
model AiChatMessage {
  id               String   @id @default(uuid())
  session_id       String
  /// CHECK: system | user | assistant
  role             String
  content          String
  provider         String?
  model            String?
  tokens_used      Int?
  response_time_ms Int?
  cached           Boolean  @default(false)
  metadata         Json?
  created_at       DateTime @default(now())

  session AiChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id, created_at])
  @@index([role])
  @@index([created_at])
}

// ------------------------------------
// LEGAL MEMO (AI-generated legal memos — persisted)
// ------------------------------------
model LegalMemo {
  id               String   @id @default(uuid())
  case_id          String? // FK → Case (optional; can be standalone)
  author_id        String // FK → User
  title            String
  facts            String? // Statement of facts
  issues           String? // Legal issues
  jurisdiction     String? // SA jurisdiction context
  content          String // Full memo content (markdown)
  provider         String?
  model            String?
  tokens_used      Int?
  response_time_ms Int?
  version          Int      @default(1)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  case   Case? @relation(fields: [case_id], references: [id])
  author User  @relation("LegalMemoAuthor", fields: [author_id], references: [id])

  @@index([case_id])
  @@index([author_id])
  @@index([created_at])
}

// ============================================================================
// SECTION 8 — COMMUNICATIONS (Email + SMS)
// ============================================================================

// ------------------------------------
// COMMUNICATION LOGS (Email + SMS tracking, inbound + outbound)
// ------------------------------------
model CommunicationLog {
  id              String    @id @default(uuid())
  user_id         String?
  recipient_email String?
  recipient_phone String?
  recipient_name  String?
  /// CHECK: email | sms
  channel         String
  /// CHECK: welcome | verification | consultation_reminder | case_update | payment_confirmation | marketing | notification | custom
  category        String    @default("custom")
  is_inbound      Boolean   @default(false) // Distinguish contact-form submissions from outbound
  subject         String?
  content         String
  /// CHECK: pending | sent | delivered | failed | bounced
  status          String    @default("pending")
  provider_id     String? // External provider message ID (Resend/Twilio)
  provider        String? // resend | twilio | simulated | contact_form
  opened_at       DateTime? // Email open tracking
  clicked_at      DateTime? // Email click tracking
  error_message   String?
  metadata        Json?
  sent_at         DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user User? @relation(fields: [user_id], references: [id])

  @@index([user_id, created_at])
  @@index([channel, status, created_at])
  @@index([status])
  @@index([category])
  @@index([is_inbound])
  @@index([created_at])
}

// ------------------------------------
// EMAIL TEMPLATES
// ------------------------------------
model EmailTemplate {
  id         String   @id @default(uuid())
  name       String   @unique
  /// CHECK: email | sms
  channel    String   @default("email")
  /// CHECK: welcome | verification | consultation_reminder | case_update | payment_confirmation | marketing | notification | custom
  category   String   @default("custom")
  language   String   @default("en") // SA has 11 official languages
  subject    String? // Email subject line (null for SMS)
  body_html  String? // HTML template for emails
  body_text  String? // Plain text template (for SMS or email fallback)
  variables  Json? // Available template variables
  is_active  Boolean  @default(true)
  is_system  Boolean  @default(false) // System templates cannot be deleted
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([name])
  @@index([channel])
  @@index([category])
  @@index([language])
  @@index([is_active])
}

// ============================================================================
// SECTION 9 — AUDIT & OPERATIONS
// ============================================================================

// ------------------------------------
// AUDIT LOGS
// ------------------------------------
model AuditLog {
  id            String   @id @default(uuid())
  user_id       String?
  action        String
  resource_type String
  resource_id   String?
  details       Json?
  /// CHECK: info | warning | error | critical
  severity      String   @default("info")
  session_id    String? // Correlate events within a user session
  ip_address    String?
  user_agent    String?
  created_at    DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id])

  @@index([action, created_at])
  @@index([user_id, created_at])
  @@index([resource_type, resource_id])
  @@index([severity])
  @@index([created_at])
}

// ------------------------------------
// WEBHOOK EVENT (Idempotency for Stripe / PayFast / Clerk webhooks)
// ------------------------------------
model WebhookEvent {
  id            String   @id @default(uuid())
  /// CHECK: stripe | payfast | clerk
  provider      String
  event_id      String // External event ID (Stripe evt_*, PayFast ITN ref, etc.)
  event_type    String // checkout.session.completed, customer.subscription.deleted, etc.
  payload       Json? // Raw webhook payload
  /// CHECK: processed | failed | duplicate
  status        String   @default("processed")
  error_message String?
  processed_at  DateTime @default(now())
  created_at    DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id])
  userId        String?

  @@unique([provider, event_id])
  @@index([provider, event_type])
  @@index([status])
  @@index([created_at])
}

// ------------------------------------
// BACKUP RECORD (Database/file backup tracking)
// ------------------------------------
model BackupRecord {
  id               String    @id @default(uuid())
  filename         String
  /// CHECK: manual | scheduled | pre_migration
  backup_type      String    @default("manual")
  /// CHECK: pending | completed | failed | partial
  status           String    @default("pending")
  size_bytes       Int?
  storage_location String?
  checksum         String? // For integrity verification
  error_message    String?
  started_at       DateTime  @default(now())
  completed_at     DateTime?
  initiated_by     String // FK → User
  metadata         Json?
  created_at       DateTime  @default(now())

  initiator User @relation(fields: [initiated_by], references: [id])

  @@index([status, created_at])
  @@index([backup_type])
  @@index([initiated_by])
  @@index([created_at])
}

// ------------------------------------
// SYSTEM SETTINGS (CRM / firm-wide configuration)
// ------------------------------------
model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  /// CHECK: string | number | boolean | json
  type        String   @default("string")
  description String?
  updated_by  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([key])
}

// ============================================================================
// SECTION 10 — KNOWLEDGE BASE
// ============================================================================

// ------------------------------------
// LEGAL ARTICLES (Knowledge base / blog)
// ------------------------------------
model LegalArticle {
  id               String    @id @default(uuid())
  slug             String    @unique
  title            String
  subtitle         String?
  content          String
  summary          String?
  category         String
  tags             Json? // was String[] in PG
  cover_image_url  String?
  author_id        String? // FK → User (kept as String for back-compat; relation below)
  reading_time_min Int?
  view_count       Int       @default(0) // Analytics on article popularity
  is_published     Boolean   @default(false)
  is_featured      Boolean   @default(false)
  published_at     DateTime?
  sort_order       Int       @default(0)
  metadata         Json?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  author User? @relation("ArticleAuthor", fields: [author_id], references: [id])

  @@index([slug])
  @@index([category])
  @@index([is_published])
  @@index([published_at])
  @@index([author_id])
}
